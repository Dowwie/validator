{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,"required":["schema_version","task","episodes"],
  "properties":{"schema_version":{"const":2},"task":{"$ref":"#/$defs/task"},"episodes":{"type":"array","items":{"$ref":"#/$defs/episode"}}},
  "allOf":[{"if":{"properties":{"task":{"properties":{"kind":{"const":"single_label"}}}}},"then":{"properties":{"episodes":{"items":{"properties":{"expected":{"$ref":"#/$defs/class_target"}}}}}}},{"if":{"properties":{"task":{"properties":{"kind":{"const":"multi_label"}}}}},"then":{"properties":{"episodes":{"items":{"properties":{"expected":{"$ref":"#/$defs/labels_target"}}}}}}}],
  "$defs":{
    "id":{"type":"string","format":"uuid"},
    "label":{"type":"string","pattern":".*\\S.*"},
    "task":{"oneOf":[{"type":"object","additionalProperties":false,"required":["kind","labels"],"properties":{"kind":{"const":"single_label"},"labels":{"type":"array","minItems":2,"uniqueItems":true,"items":{"$ref":"#/$defs/label"}}}},{"type":"object","additionalProperties":false,"required":["kind","labels"],"properties":{"kind":{"const":"multi_label"},"labels":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/label"}}}}]},
    "class_target":{"type":"object","additionalProperties":false,"required":["type","label"],"properties":{"type":{"const":"class"},"label":{"$ref":"#/$defs/label"}}},
    "labels_target":{"type":"object","additionalProperties":false,"required":["type","labels"],"properties":{"type":{"const":"labels"},"labels":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/label"}}}},
    "episode":{"type":"object","additionalProperties":false,"required":["id","expected","input"],"properties":{"id":{"$ref":"#/$defs/id"},"expected":{"oneOf":[{"$ref":"#/$defs/class_target"},{"$ref":"#/$defs/labels_target"}]},"input":{}}}
  }
}
