{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "status", "task", "integrity", "selected_ids"],
  "properties": {
    "schema_version": {"const": 2},
    "kind": {"const": "check"},
    "status": {"const": "complete"},
    "task": {"$ref": "#/$defs/task"},
    "integrity": true,
    "selected_ids": {"$ref": "#/$defs/ids"}
  },
  "allOf": [
    {
      "if": {"properties": {"task": {"properties": {"kind": {"const": "single_label"}}}}},
      "then": {"properties": {"integrity": {"$ref": "#/$defs/singleIntegrity"}}},
      "else": {"properties": {"integrity": {"$ref": "#/$defs/multiIntegrity"}}}
    }
  ],
  "$defs": {
    "text": {"type": "string", "pattern": ".*\\S.*"},
    "id": {"type": "string", "format": "uuid"},
    "count": {"type": "integer", "minimum": 0},
    "ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "task": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "labels"],
          "properties": {
            "kind": {"const": "single_label"},
            "labels": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "labels"],
          "properties": {
            "kind": {"const": "multi_label"},
            "labels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
          }
        }
      ]
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_count", "selected_count", "prediction_count", "missing_ids", "extra_ids", "signal_availability"],
      "properties": {
        "source_count": {"$ref": "#/$defs/count"},
        "selected_count": {"$ref": "#/$defs/count"},
        "prediction_count": {"$ref": "#/$defs/count"},
        "missing_ids": {"$ref": "#/$defs/ids"},
        "extra_ids": {"$ref": "#/$defs/ids"},
        "signal_availability": true,
        "normalized_count": {"$ref": "#/$defs/count"},
        "maximum_sum_error": {"type": "number", "minimum": 0}
      }
    },
    "singleIntegrity": {
      "allOf": [
        {"$ref": "#/$defs/integrity"},
        {
          "required": ["normalized_count", "maximum_sum_error"],
          "properties": {
            "signal_availability": {"enum": ["none", "categorical", "confidence", "both"]}
          }
        }
      ]
    },
    "multiIntegrity": {
      "allOf": [
        {"$ref": "#/$defs/integrity"},
        {
          "properties": {"signal_availability": {"enum": ["none", "marginals"]}},
          "not": {"anyOf": [{"required": ["normalized_count"]}, {"required": ["maximum_sum_error"]}]}
        }
      ]
    }
  }
}
